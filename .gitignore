# ==============================================================================
# GitPulse .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# Backend: Java & Spring Boot / Maven / Gradle
# ------------------------------------------------------------------------------
backend-spring/target/
backend-spring/*.jar
backend-spring/*.war
backend-spring/.mvn/timing.properties
backend-spring/.mvn/wrapper/maven-wrapper.jar

# IDE & Editor specific files
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
bin/
out/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# Frontend: Node / React / Vite
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/*.local
frontend/.eslintcache
frontend/.stylelintcache
frontend/coverage/

# ------------------------------------------------------------------------------
# Docker & Database
# ------------------------------------------------------------------------------
postgres_data/
docker_data/
*.pid
*.seed
*.pid.lock

# H2 In-Memory/File DB
*.mv.db
*.trace.db
