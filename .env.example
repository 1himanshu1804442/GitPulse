# Copy this file to .env and configure your local credentials as needed.

POSTGRES_USER=gitpulse_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=gitpulse_db

# Optional GitHub Personal Access Token (or leave blank to auto-detect from 'gh auth')
GITHUB_TOKEN=
